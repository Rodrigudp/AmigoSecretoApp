{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://127.0.0.1:3000"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://papelzinho.app",
        "EXPO_PUBLIC_MOBILE_API": "live"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://papelzinho.app",
        "EXPO_PUBLIC_MOBILE_API": "live"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "closedTesting"
      },
      "ios": {
        "appleId": "rodrigo21437@gmail.com"
      }
    }
  }
}
