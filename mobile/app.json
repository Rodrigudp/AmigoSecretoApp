{
  "expo": {
    "name": "Papelzinho",
    "slug": "papelzinho",
    "version": "0.1.0",
    "scheme": "papelzinho",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "app.papelzinho",
      "associatedDomains": ["applinks:papelzinho.app"]
    },
    "android": {
      "package": "app.papelzinho",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "papelzinho.app",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "papelzinho.app",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "papelzinho.app",
              "pathPrefix": "/admin/"
            }
          ]
        }
      ]
    }
  }
}
