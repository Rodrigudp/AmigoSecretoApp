{
  "expo": {
    "name": "Papelzinho",
    "slug": "papelzinho",
    "version": "1.0.0",
    "scheme": "papelzinho",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-ios.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-notifications", { "icon": "./assets/notification-icon.png" }],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F4"
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "app.papelzinho",
      "buildNumber": "1",
      "associatedDomains": ["applinks:papelzinho.app"]
    },
    "android": {
      "package": "app.papelzinho",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-android-foreground.png",
        "backgroundImage": "./assets/icon-android-background.png",
        "backgroundColor": "#F6F5F4",
        "monochromeImage": "./assets/icon-android-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "https",
              "host": "papelzinho.app",
              "pathPrefix": "/g/"
            },
            {
              "scheme": "https",
              "host": "papelzinho.app",
              "pathPrefix": "/p/"
            },
            {
              "scheme": "https",
              "host": "papelzinho.app",
              "pathPrefix": "/admin/"
            }
          ]
        }
      ]
    }
  }
}
